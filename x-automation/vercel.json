    { "path": "/api/cron/2", "schedule": "0 4 * * *" },
    { "path": "/api/cron/3", "schedule": "0 5 * * *" },
    { "path": "/api/cron/4", "schedule": "0 7 * * *" },
    { "path": "/api/cron/5", "schedule": "0 8 * * *" },
    { "path": "/api/cron/6", "schedule": "0 10 * * *" },
    { "path": "/api/cron/7", "schedule": "0 11 * * *" },
    { "path": "/api/cron/8", "schedule": "0 13 * * *" },
    { "path": "/api/cron/9", "schedule": "0 15 * * *" },
    { "path": "/api/cron/10", "schedule": "0 17 * * *" }
  ]
}
